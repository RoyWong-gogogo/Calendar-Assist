# calendar-agent 配置示例
# 复制为 .env 后按需修改；.env 含本机配置，不要提交 Git。
# 不创建 .env 时，以下默认值自动生效。

# ---- 日历服务提供方 ----
# outlook（默认，中国区 Graph）/ ics（只读订阅后备）/ google（过渡期保留）
CALENDAR_PROVIDER=outlook

# ---- Outlook Calendar（Microsoft Graph，当前主后端）----
# 微软云: china（世纪互联运营，默认）| global（全球版）
OUTLOOK_CLOUD=china
# Azure 门户应用注册的 Application (client) ID（使用 Outlook 时必填）
OUTLOOK_CLIENT_ID=
# Directory (tenant) ID（App registration → Overview 页；留空使用 organizations）
OUTLOOK_TENANT_ID=
# 授权方式: device（设备代码流，默认）| interactive（交互式浏览器流程）
OUTLOOK_AUTH_FLOW=device
# MSAL token 缓存文件（首次授权后自动生成）
# OUTLOOK_TOKEN_FILE=credentials/outlook_token.bin

# ---- 会议室（Exchange room mailbox）----
# 会议室邮箱形如 CDConfRoom808@arraycomm.com（前缀 + 编号 @ 域名）。
# 中国区 Graph 没有可用的会议室清单接口，scripts/list_rooms.py 按此规律扫描编号区间
# 发现会议室；预订时把会议室作为 resource 与会人写入事件（create/update_event --room）。
ROOM_NAME_PREFIX=CDConfRoom
ROOM_EMAIL_DOMAIN=arraycomm.com

# ---- ICS 订阅（只读后备）----
# Outlook 网页版 → 设置 → 日历 → 共享日历 → 发布日历 → Publish →
# 复制 ICS 链接（用于订阅的那个，不是 HTML 链接）。
# 注意：此链接等同凭证，任何拿到的人都能查看你的日历，不要提交 Git。
ICS_URL=

# 解析日期时间使用的默认时区（IANA 名称）
CALENDAR_TIMEZONE=Asia/Shanghai

# 以下为 Google 后端配置（仅 CALENDAR_PROVIDER=google 时使用）

# 要操作的 Google 日历 ID，"primary" 表示主日历
GOOGLE_CALENDAR_ID=primary

# OAuth 客户端 JSON（从 Google Cloud Console 下载）；相对路径基于项目根目录
# GOOGLE_CREDENTIALS_FILE=credentials/credentials.json

# 缓存的 OAuth token（首次授权后自动生成）
# GOOGLE_TOKEN_FILE=credentials/token.json
