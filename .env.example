# calendar-agent 配置示例
# 复制为 .env 后按需修改；.env 含本机配置，不要提交 Git。
# 不创建 .env 时，以下默认值自动生效。

# 解析日期时间使用的默认时区（IANA 名称）
CALENDAR_TIMEZONE=Asia/Shanghai

# 要操作的 Google 日历 ID，"primary" 表示主日历
GOOGLE_CALENDAR_ID=primary

# OAuth 客户端 JSON（从 Google Cloud Console 下载）；相对路径基于项目根目录
# GOOGLE_CREDENTIALS_FILE=credentials/credentials.json

# 缓存的 OAuth token（首次授权后自动生成）
# GOOGLE_TOKEN_FILE=credentials/token.json
